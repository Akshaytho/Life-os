{
  "name": "@life-os/api",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/run-migrations.ts",
    "migrate:apply": "tsx src/run-migrations.ts --apply",
    "db-role": "tsx src/run-application-db-role.ts",
    "db-role:apply": "tsx src/run-application-db-role.ts --apply",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "pg": "8.23.0",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.21.0"
  }
}
