# Development placeholders only. Never commit real secrets.

NODE_ENV=development

# Life OS runtime provenance
# local | ci | development | production
LIFE_OS_ENVIRONMENT=local
# Required outside local unless supplied by the hosting/CI platform.
# Railway GitHub deploys can provide RAILWAY_GIT_COMMIT_SHA automatically.
LIFE_OS_RELEASE_SHA=

# Supabase / PostgreSQL
SUPABASE_URL=
# Browser-safe Supabase publishable key. The API session verifier sends this only as the Supabase `apikey` header.
SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-safe anon key fallback for projects that have not moved to publishable keys yet.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this in browser code. Ordinary private Life OS DB traffic should not depend on bypass-RLS service access.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Future Railway API database connection using the least-privileged Life OS application role.
DATABASE_URL=
# ADMIN / MIGRATION ONLY. Never use this as the normal running API credential.
MIGRATION_DATABASE_URL=

# OpenAI
# SERVER ONLY.
OPENAI_API_KEY=

# Application
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# MCP (future)
MCP_ENABLED=false
