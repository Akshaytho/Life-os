# Development placeholders only. Never commit real secrets.

NODE_ENV=development

# Life OS runtime provenance
# local | ci | development | production
LIFE_OS_ENVIRONMENT=local
# Required outside local unless supplied by the hosting/CI platform.
# Railway GitHub deploys can provide RAILWAY_GIT_COMMIT_SHA automatically.
LIFE_OS_RELEASE_SHA=
# Private HTTP surface is opt-in. V1 permits local/CI/development only and refuses production activation.
LIFE_OS_PRIVATE_API_ENABLED=false

# Supabase / PostgreSQL
SUPABASE_URL=
# Browser-safe Supabase publishable key. The API session verifier sends this only as the Supabase `apikey` header.
SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-safe anon key fallback for projects that have not moved to publishable keys yet.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this in browser code. Ordinary private Life OS DB traffic must not depend on bypass-RLS service access.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Railway API connection using the least-privileged non-owner NOBYPASSRLS Life OS application role.
DATABASE_URL=
# ADMIN / MIGRATION / ROLE PROVISIONING ONLY. Never use this as the normal running API credential.
MIGRATION_DATABASE_URL=
# Role provisioning metadata. `db-role` defaults to this name; `db-role:apply` uses the password only to create/rotate the login.
LIFE_OS_APPLICATION_DB_ROLE=lifeos_app
# ADMIN TOOL INPUT ONLY. Store the real value in your local/platform secret system, never Git or browser code.
LIFE_OS_APPLICATION_DB_PASSWORD=

# OpenAI
# SERVER ONLY. Not required for Safe Fallback Capture.
OPENAI_API_KEY=

# Application
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# MCP (future)
MCP_ENABLED=false
