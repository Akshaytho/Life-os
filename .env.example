# Development placeholders only. Never commit real secrets.

NODE_ENV=development

# Life OS runtime provenance
# local | ci | development | production
LIFE_OS_ENVIRONMENT=local
# Required outside local unless supplied by the hosting/CI platform.
# Railway GitHub deploys can provide RAILWAY_GIT_COMMIT_SHA automatically.
LIFE_OS_RELEASE_SHA=
# Production-only, non-secret release approval. Must equal the exact deployed 40-character commit SHA.
# Update for every reviewed production release; a stale approval intentionally blocks startup.
LIFE_OS_PRODUCTION_RELEASE_SHA=
# Private HTTP surface is opt-in. Production additionally requires the exact release approval above.
LIFE_OS_PRIVATE_API_ENABLED=false
# Separate SERVER-side high-authority Direction gate. Keep false until migration 0007 and the reviewed
# Direction capability role grants are applied. Requires LIFE_OS_PRIVATE_API_ENABLED=true.
LIFE_OS_DIRECTION_ENABLED=false
# Separate SERVER-side Daily Return gate. Keep false until migration 0008 and the reviewed
# Daily Return capability grants are applied. Requires LIFE_OS_PRIVATE_API_ENABLED=true.
LIFE_OS_DAILY_RETURN_ENABLED=false
# Separate SERVER-side Brain Dump + NOT NOW gate. Keep false until migration 0009 and the reviewed
# capability grants are applied. Requires LIFE_OS_PRIVATE_API_ENABLED=true.
LIFE_OS_BRAIN_DUMP_NOT_NOW_ENABLED=false
LIFE_OS_DRIFT_RETURN_ENABLED=false
LIFE_OS_JOURNEY_PRACTICE_ENABLED=false
# Read-only Ask Life OS retrieval is separately opt-in. Having OPENAI_API_KEY set does not enable it.
LIFE_OS_AI_RETRIEVAL_ENABLED=false
LIFE_OS_PERIODIC_REVIEWS_ENABLED=false
# When both Ask and Memory are true, current retained Memory may join Ask as source-visible REFLECTION.
# Ask never reads Memory candidates/history or gains Memory write authority.
LIFE_OS_MEMORY_ENABLED=false
# Weekly + Monthly Reviews additionally requires the Daily Return, Brain Dump + NOT NOW,
# Drift + Return, and Journey Practice source capabilities to be explicitly enabled.
# Exact browser origins allowed to call /api/v1/*, comma-separated. No wildcard and no paths.
# Example: http://localhost:3000,https://life-os-web.example
LIFE_OS_CORS_ALLOWED_ORIGINS=

# Supabase / PostgreSQL
SUPABASE_URL=
# Browser-safe Supabase publishable key. The API session verifier sends this only as the Supabase `apikey` header.
SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-safe anon key fallback for projects that have not moved to publishable keys yet.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this in browser code. Ordinary private Life OS DB traffic must not depend on bypass-RLS service access.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Railway API connection using the least-privileged non-owner NOBYPASSRLS Life OS application role.
# Connection identity only: protocol, user, password, host, port, database. SSL parameters
# (sslmode/sslrootcert/sslcert/sslkey) are refused here so they cannot override the reviewed TLS object below.
DATABASE_URL=
# Database transport contract. V1 supports exactly two states and no ambiguous middle mode:
#   disable      local/CI disposable PostgreSQL only
#   verify-full  TLS encryption + CA verification + hostname verification
# `disable` is refused whenever DATABASE_URL is used with LIFE_OS_ENVIRONMENT=development.
LIFE_OS_DATABASE_TLS_MODE=
# Repository path to the reviewed public provider CA, required when the mode is verify-full.
# Public trust material committed with the release, never a secret and never downloaded at startup.
# Hosted development value: apps/api/certs/supabase-root-2021.crt
LIFE_OS_DATABASE_TLS_CA_FILE=
# ADMIN / MIGRATION / ROLE PROVISIONING ONLY. Never use this as the normal running API credential.
MIGRATION_DATABASE_URL=
# Role provisioning metadata. `db-role` defaults to this name; `db-role:apply` uses the password only to create/rotate the login.
LIFE_OS_APPLICATION_DB_ROLE=lifeos_app
# ADMIN TOOL INPUT ONLY. Store the real value in your local/platform secret system, never Git or browser code.
LIFE_OS_APPLICATION_DB_PASSWORD=

# Web deployment mode. Local/visual prototypes may omit this (defaults to prototype).
# A hosted phone-usable service must set `live`; build validation then requires all public API/Auth values below.
LIFE_OS_WEB_DEPLOYMENT=prototype
# Browser-safe live Capture / canonical read configuration.
# These NEXT_PUBLIC values are intentionally shipped to browser JavaScript. Use only public origins and the publishable key.
NEXT_PUBLIC_LIFE_OS_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Separate high-authority browser gate. Keep false until the SERVER Direction flag, migration 0007,
# least-privilege Direction grants, private runtime composition and live verification are all complete.
NEXT_PUBLIC_LIFE_OS_DIRECTION_ENABLED=false
# Separate Daily Return browser gate. Keep false until the SERVER flag, migration, narrow
# table grants, private runtime composition and live verification are all complete.
NEXT_PUBLIC_LIFE_OS_DAILY_RETURN_ENABLED=false
# Browser projection gate. Enable only after Direction, Journey, Drift, Memory, Calendar,
# and Daily Return private server capabilities pass their independent readiness checks.
NEXT_PUBLIC_LIFE_OS_TODAY_COMPOSITION_ENABLED=false

# Trusted AI Capture interpretation (SERVER ONLY, explicit opt-in).
# Disabled by default; SafeFallback remains the exact runtime behavior when false/absent.
LIFE_OS_AI_INTERPRETER_ENABLED=false
# Explicit model choice is required when the interpreter is enabled. No paid/default model is selected silently.
LIFE_OS_AI_MODEL=
# Explicit model for read-only Ask Life OS retrieval. It is independent from Capture interpretation.
LIFE_OS_AI_RETRIEVAL_MODEL=
# SERVER ONLY. Sent only in the OpenAI Authorization header; never browser code or telemetry.
OPENAI_API_KEY=

# Application
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# MCP (future)
MCP_ENABLED=false

# Hosted API preflight (operator/session input only, never platform variables or Git)
# Base origin of the deployed development API, e.g. https://<service>.up.railway.app
LIFE_OS_PREFLIGHT_BASE_URL=
# Short-lived Supabase USER access token for the synthetic development account.
# Never the service_role key and never a real personal account token.
LIFE_OS_PREFLIGHT_ACCESS_TOKEN=

# Hosted WEB preflight (operator input only; both values are non-secret).
# Exact HTTPS origin of the deployed phone-facing web service.
LIFE_OS_WEB_PREFLIGHT_BASE_URL=
# dormant | enabled. Omit to expect dormant during the initial phone deployment.
LIFE_OS_WEB_PREFLIGHT_EXPECT_DIRECTION=dormant
