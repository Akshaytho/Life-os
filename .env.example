# Development placeholders only. Never commit real secrets.

NODE_ENV=development

# Life OS runtime provenance
# local | ci | development | production
LIFE_OS_ENVIRONMENT=local
# Required outside local unless supplied by the hosting/CI platform.
# Railway GitHub deploys can provide RAILWAY_GIT_COMMIT_SHA automatically.
LIFE_OS_RELEASE_SHA=
# Private HTTP surface is opt-in. V1 permits local/CI/development only and refuses production activation.
LIFE_OS_PRIVATE_API_ENABLED=false
# Separate SERVER-side high-authority Direction gate. Keep false until migration 0007 and the reviewed
# Direction capability role grants are applied. Requires LIFE_OS_PRIVATE_API_ENABLED=true.
LIFE_OS_DIRECTION_ENABLED=false
# Exact browser origins allowed to call /api/v1/*, comma-separated. No wildcard and no paths.
# Example: http://localhost:3000,https://life-os-web.example
LIFE_OS_CORS_ALLOWED_ORIGINS=

# Supabase / PostgreSQL
SUPABASE_URL=
# Browser-safe Supabase publishable key. The API session verifier sends this only as the Supabase `apikey` header.
SUPABASE_PUBLISHABLE_KEY=
# Legacy browser-safe anon key fallback for projects that have not moved to publishable keys yet.
SUPABASE_ANON_KEY=
# SERVER ONLY. Never expose this in browser code. Ordinary private Life OS DB traffic must not depend on bypass-RLS service access.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Railway API connection using the least-privileged non-owner NOBYPASSRLS Life OS application role.
DATABASE_URL=
# ADMIN / MIGRATION / ROLE PROVISIONING ONLY. Never use this as the normal running API credential.
MIGRATION_DATABASE_URL=
# Role provisioning metadata. `db-role` defaults to this name; `db-role:apply` uses the password only to create/rotate the login.
LIFE_OS_APPLICATION_DB_ROLE=lifeos_app
# ADMIN TOOL INPUT ONLY. Store the real value in your local/platform secret system, never Git or browser code.
LIFE_OS_APPLICATION_DB_PASSWORD=

# Web deployment mode. Local/visual prototypes may omit this (defaults to prototype).
# A hosted phone-usable service must set `live`; build validation then requires all public API/Auth values below.
LIFE_OS_WEB_DEPLOYMENT=prototype
# Browser-safe live Capture / canonical read configuration.
# These NEXT_PUBLIC values are intentionally shipped to browser JavaScript. Use only public origins and the publishable key.
NEXT_PUBLIC_LIFE_OS_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Separate high-authority browser gate. Keep false until the SERVER Direction flag, migration 0007,
# least-privilege Direction grants, private runtime composition and live verification are all complete.
NEXT_PUBLIC_LIFE_OS_DIRECTION_ENABLED=false

# Trusted AI Capture interpretation (SERVER ONLY, explicit opt-in).
# Disabled by default; SafeFallback remains the exact runtime behavior when false/absent.
LIFE_OS_AI_INTERPRETER_ENABLED=false
# Explicit model choice is required when the interpreter is enabled. No paid/default model is selected silently.
LIFE_OS_AI_MODEL=
# SERVER ONLY. Sent only in the OpenAI Authorization header; never browser code or telemetry.
OPENAI_API_KEY=

# Application
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# MCP (future)
MCP_ENABLED=false

# Hosted preflight (operator/session input only, never platform variables or Git)
# Base origin of the deployed development API, e.g. https://<service>.up.railway.app
LIFE_OS_PREFLIGHT_BASE_URL=
# Short-lived Supabase USER access token for the synthetic development account.
# Never the service_role key and never a real personal account token.
LIFE_OS_PREFLIGHT_ACCESS_TOKEN=
